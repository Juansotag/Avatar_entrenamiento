# =====================================================================
# CONFIGURACIÓN UNIFICADA: SIMULADOR DE NEGOCIACIÓN + EXTRACTORES RAG
# =====================================================================
# Copia este archivo a .env y llena los valores correspondientes.

# ---------------------------------------------------------------------
# Claves para los Extractores RAG
# ---------------------------------------------------------------------
# Obtén tu clave gratuita de Gemini en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ---------------------------------------------------------------------
# Claves para el Simulador de Negociación
# ---------------------------------------------------------------------
# Cerebro del personaje (Anthropic Claude)
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Transcripción de voz del usuario (OpenAI Whisper) + voz del personaje (OpenAI TTS)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Voz del personaje para TTS. Opciones: alloy, echo, fable, onyx, nova, shimmer
# 'onyx' = grave y profesional (recomendado para avatar de negociación)
OPENAI_TTS_VOICE=onyx

# Modelo de Claude a utilizar (claude-opus-4-8 o claude-sonnet-5)
MODEL_NAME=claude-opus-4-8
